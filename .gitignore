# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
backend/.env

# Node
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

.DS_Store

# Downloaded datasets (large; provenance lives in data/raw/*/source.json)
data/raw/**
!data/raw/**/
!data/raw/**/source.json

# Global H3 layers (~1.3 GB, regenerated by scripts/ — see data/STATUS.md)
data/prepared/*_h3r6.parquet

# Larger prepared record layers and scene PNGs (rebuilt by scripts/prepare_feature_layers.py and
# scripts/prepare_imagery.py); the small layers and every manifest stay committed.
data/prepared/features/mrds.parquet
data/prepared/features/hydrorivers.geojson
data/prepared/imagery/*.png

# Live-source response cache (rebuilt automatically)
data/cache/
data/*.log
